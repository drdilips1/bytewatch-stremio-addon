<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 10+: follow the system light/dark setting (the web UI reads prefers-color-scheme). -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">#D93025</item>
        <item name="android:colorPrimaryDark">#B3261E</item>
        <item name="android:colorAccent">#D93025</item>
        <item name="android:statusBarColor">#B3261E</item>
    </style>
</resources>
