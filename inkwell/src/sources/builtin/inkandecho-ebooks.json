{
  "schemaVersion": "1.0.0",
  "id": "inkandecho-v2-bestsearch-ebook",
  "name": "Ink & Echo Ebooks",
  "version": "1.0.0",
  "description": "Ink & Echo source for ebooks. Search mode: Best. Resolver: TorBox. Language: English.",
  "icon": "https://i.ibb.co/wJ13Y1y/logo.png",
  "provides": [
    "source",
    "search"
  ],
  "contentType": "ebook",
  "rateLimit": {
    "requestsPerMinute": 10,
    "retryAfterMs": 6000
  },
  "matching": {
    "algorithm": "fuzzy",
    "threshold": 0.4
  },
  "adapters": {
    "source": {
      "request": {
        "method": "POST",
        "url": "https://inkandecho-builder.pages.dev/ebook/search?debrid=torbox&profile=best&client=ie_bbb06c1c17904fdfd1a0bdc7&cacheBust=source-contract-v9&torboxTier=standard&lang=en&experimental=1&titleStyle=clean",
        "timeout": 30000,
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "body": {
          "title": "{TITLE}",
          "author": "{AUTHOR}",
          "limit": 80,
          "contentType": "ebook"
        }
      },
      "response": {
        "type": "json",
        "resultsPath": "results",
        "mapping": {
          "title": "fileTypeTitle",
          "author": "author",
          "sizeBytes": "sizeBytes",
          "seeders": "seeders",
          "format": "fileType",
          "date": "posted",
          "debridCache": "debridCache",
          "magnetUrl": "magnetUrl",
          "infoHash": "infoHash",
          "url": "ebookUrl"
        }
      }
    }
  }
}