+// What this edition of the app includes. AudioYam Lite (the store app) keeps:
+// free audiobooks & ebooks, phone folders, podcasts, add-ons, paste a link, Open Library,
+// the player (resume, per-book speed, bookmarks, offline downloads), the reader with the
+// phone's own voices and highlights, library & home, covers, backup, What's new / Report.
+// Everything else is switched off here — the code stays, the feature doesn't show.
+export const EDITION = 'lite';
+
+export const FEATURES = {
+  audiobookshelf: false,
+  account: false, // sign-in and sync between devices
+  ai: false, // Ask, summaries, X-Ray, recap, transcript, translate, bookseller
+  catalogs: false, // Audible / Google Books listings, Hindi section, ratings, recommendations
+  goodreads: false, // Goodreads / Hardcover shelves
+  storyshots: false,
+  upNext: false,
+  history: false,
+  carMode: false, // car mode and voice commands
+  widget: false,
+  plans: false, // listening plans (10 / 30 / 60 minutes)
+  tags: false, // tags, smart shelves, series progress
+  stats: false,
+  quotes: false, // shared quote cards
+  kindle: false,
+  naturalVoices: false, // Microsoft Edge voices (phone voices only)
+  themes: false, // colour themes / accents (default look only)
+};
+
+export const has = (name) => FEATURES[name] !== false;
