{
  "appId": "app.audibrisk.player",
  "appName": "Audibrisk",
  "webDir": "dist-brisk",
  "backgroundColor": "#f6efe4",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#f6efe4"
  },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorCookies": { "enabled": true },
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#f6efe4",
      "showSpinner": false
    },
    "StatusBar": { "overlaysWebView": true, "style": "LIGHT" }
  }
}
