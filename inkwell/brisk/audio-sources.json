{
  "name": "Audio sources",
  "addons": [
    {
      "schemaVersion": "1.0.0",
      "id": "public-audiobookbay",
      "name": "AudiobookBay",
      "version": "1.0.0",
      "description": "Audiobook torrents from AudiobookBay. Needs TorBox or Real-Debrid to play.",
      "icon": "https://audiobookbay.lu/apple-touch-icon.png",
      "provides": [
        "source"
      ],
      "contentType": "audiobook",
      "rateLimit": {
        "requestsPerMinute": 10,
        "retryAfterMs": 6000
      },
      "matching": {
        "algorithm": "fuzzy",
        "threshold": 0.4
      },
      "adapters": {
        "source": {
          "request": {
            "method": "GET",
            "url": "https://sources.booksources.workers.dev/abb/search?q={QUERY}",
            "timeout": 45000,
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "type": "json",
            "resultsPath": "results",
            "mapping": {
              "title": "title",
              "infoHash": "infoHash",
              "magnetUrl": "magnetUrl",
              "sizeBytes": "sizeBytes",
              "format": "format",
              "date": "date",
              "language": "language",
              "pageUrl": "pageUrl"
            }
          }
        }
      }
    },
    {
      "schemaVersion": "1.0.0",
      "id": "public-knaben-audiobooks",
      "name": "Knaben AudioBooks",
      "version": "1.0.0",
      "description": "Audiobook torrents found by Knaben (many sites at once). Needs TorBox or Real-Debrid to play.",
      "icon": "https://knaben.org/favicon.ico",
      "provides": [
        "source"
      ],
      "contentType": "audiobook",
      "matching": {
        "algorithm": "fuzzy",
        "threshold": 0.6
      },
      "adapters": {
        "source": {
          "request": {
            "method": "GET",
            "url": "https://sources.booksources.workers.dev/knaben/audiobooks?q={TITLE}",
            "timeout": 30000,
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "type": "json",
            "resultsPath": "hits",
            "mapping": {
              "title": "title",
              "magnetUrl": "magnetUrl",
              "infoHash": "hash",
              "sizeBytes": "bytes",
              "seeders": "seeders",
              "date": "date"
            }
          }
        }
      }
    },
    {
      "schemaVersion": "1.0.0",
      "id": "inkandecho-v2-bestsearch-audiobook",
      "name": "Deep Search",
      "version": "1.0.0",
      "description": "A wide audiobook search across many sites, best copies first.",
      "provides": [
        "source",
        "search"
      ],
      "contentType": "audiobook",
      "rateLimit": {
        "requestsPerMinute": 10,
        "retryAfterMs": 6000
      },
      "matching": {
        "algorithm": "fuzzy",
        "threshold": 0.4
      },
      "adapters": {
        "source": {
          "request": {
            "method": "POST",
            "url": "https://inkandecho-builder.pages.dev/audiobook/search?debrid=torbox&torboxTier=standard&lang=en&profile=best&client=ie_bbb06c1c17904fdfd1a0bdc7&experimental=1&cacheBust=comics-evidence-v8&titleStyle=clean",
            "timeout": 30000,
            "headers": {
              "Accept": "application/json",
              "Content-Type": "application/json"
            },
            "body": {
              "title": "{TITLE}",
              "author": "{AUTHOR}",
              "limit": 80,
              "contentType": "audiobook"
            }
          },
          "response": {
            "type": "json",
            "resultsPath": "results",
            "mapping": {
              "title": "fileTypeTitle",
              "author": "author",
              "sizeBytes": "sizeBytes",
              "seeders": "seeders",
              "format": "fileType",
              "date": "posted",
              "debridCache": "debridCache",
              "magnetUrl": "magnetUrl",
              "infoHash": "infoHash"
            }
          }
        }
      }
    }
  ],
  "retired": [
    "my-audiobookbay",
    "my-knaben-audiobooks",
    "extto-audiohub",
    "rutracker-english-audiobooks"
  ]
}
