{
  "name": "Audio sources",
  "addons": [
    {
      "schemaVersion": "1.0.0",
      "id": "public-audiobookbay",
      "name": "AudiobookBay",
      "version": "1.0.0",
      "description": "Audiobook torrents from AudiobookBay. Needs TorBox or Real-Debrid to play.",
      "icon": "https://audiobookbay.lu/apple-touch-icon.png",
      "provides": [
        "source"
      ],
      "contentType": "audiobook",
      "rateLimit": {
        "requestsPerMinute": 10,
        "retryAfterMs": 6000
      },
      "matching": {
        "algorithm": "fuzzy",
        "threshold": 0.4
      },
      "adapters": {
        "source": {
          "request": {
            "method": "GET",
            "url": "https://sources.booksources.workers.dev/abb/search?q={QUERY}",
            "timeout": 45000,
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "type": "json",
            "resultsPath": "results",
            "mapping": {
              "title": "title",
              "infoHash": "infoHash",
              "magnetUrl": "magnetUrl",
              "sizeBytes": "sizeBytes",
              "format": "format",
              "date": "date",
              "language": "language",
              "pageUrl": "pageUrl"
            }
          }
        }
      }
    },
    {
      "schemaVersion": "1.0.0",
      "id": "public-knaben-audiobooks",
      "name": "Knaben AudioBooks",
      "version": "1.0.0",
      "description": "Audiobook torrents found by Knaben (many sites at once). Needs TorBox or Real-Debrid to play.",
      "icon": "https://knaben.org/favicon.ico",
      "provides": [
        "source"
      ],
      "contentType": "audiobook",
      "matching": {
        "algorithm": "fuzzy",
        "threshold": 0.6
      },
      "adapters": {
        "source": {
          "request": {
            "method": "GET",
            "url": "https://sources.booksources.workers.dev/knaben/audiobooks?q={TITLE}",
            "timeout": 30000,
            "headers": {
              "Accept": "application/json"
            }
          },
          "response": {
            "type": "json",
            "resultsPath": "hits",
            "mapping": {
              "title": "title",
              "magnetUrl": "magnetUrl",
              "infoHash": "hash",
              "sizeBytes": "bytes",
              "seeders": "seeders",
              "date": "date"
            }
          }
        }
      }
    },
