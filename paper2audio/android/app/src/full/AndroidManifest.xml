<?xml version="1.0" encoding="utf-8"?>
<!-- The full (sideloaded) edition: every screen, voice cloning and in-app updates. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for recording your own voice to clone it (asked when you tap Record). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Installing app updates downloaded from inside the app (Android asks the user first). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "Keep playing with the screen locked": lets the user exempt the app from battery limits. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application>
        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".LibraryActivity" />

        <activity
            android:name=".VoiceStudioActivity"
            android:exported="false"
            android:parentActivityName=".LibraryActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:parentActivityName=".PlayerActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CarModeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".PlayerActivity" />

        <activity
            android:name=".StudyActivity"
            android:exported="false"
            android:parentActivityName=".PlayerActivity" />

        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:parentActivityName=".LibraryActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LibraryActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Back from Google sign-in (account sync). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="paper2audio" android:host="auth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="image/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ShareImages"
            android:exported="true"
            android:targetActivity=".LibraryActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
