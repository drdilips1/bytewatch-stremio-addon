<?xml version="1.0" encoding="utf-8"?>
<!-- Pearl (the Paper theme, Narrato): pearl white with a faint sapphire glow at the top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4F6FA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0.0"
                android:gradientRadius="70%p"
                android:startColor="#1A3F5FD6"
                android:endColor="#003F5FD6" />
        </shape>
    </item>
</layer-list>
