<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/p2aBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Library"
                android:textColor="?attr/p2aText"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/librarySummary"
                style="@style/P2A.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFind"
            style="@style/P2A.Icon"
            android:contentDescription="Find free books and papers"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnSync"
            style="@style/P2A.Icon"
            android:contentDescription="Sync with Google Drive"
            android:src="@drawable/ic_sync" />

        <ImageButton
            android:id="@+id/btnTheme"
            style="@style/P2A.Icon"
            android:contentDescription="Theme"
            android:src="@drawable/ic_palette" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/btnAddFile"
            style="@style/P2A.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_add"
            android:text="Add file" />

        <Button
            android:id="@+id/btnAddLink"
            style="@style/P2A.Button.Soft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_link"
            android:text="arXiv / link" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/busyBar"
        style="@style/P2A.Progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/busyText"
        style="@style/P2A.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:padding="40dp"
            android:text="Your library is empty.\n\nAdd a PDF, EPUB or text file, or paste an arXiv ID or link. You can also share a file to this app from another app."
            android:textColor="?attr/p2aMuted"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/miniThumb"
            android:layout_width="42dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_thumb"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/p2aText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniSub"
                style="@style/P2A.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/miniPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_play"
            android:contentDescription="Play or pause"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="?attr/p2aOnAccent" />
    </LinearLayout>
</LinearLayout>
