<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store edition: the library, with a + button to add books and text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/p2aBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <!-- Narrato's logo beside its name. -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="?attr/p2aText"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Add: a book, a document, a web page, text or photos (the menu moved to Settings below). -->
        <Button
            android:id="@+id/btnAddTop"
            style="@style/P2A.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:drawableStart="@drawable/ic_add"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:text="Add" />
    </LinearLayout>

    <TextView
        android:id="@+id/busy"
        style="@style/P2A.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Listen to anything"
                android:textColor="?attr/p2aText"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/P2A.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Tap + to add a book, PDF, Word file, web page, photo of a page or any text. No limits, no account." />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_play"
            android:contentDescription="Add"
            android:elevation="6dp"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add"
            android:tint="?attr/p2aOnAccent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Now playing: back to the player, or play/pause, without opening the book again. -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/miniCover"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_thumb"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/p2aText"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniSub"
                style="@style/P2A.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/miniPlay"
            style="@style/P2A.Icon"
            android:contentDescription="Play"
            android:src="@drawable/ic_play" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/adBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Home, Library, Voices, Settings (filled in by LiteMainActivity): a floating dock, as in Paper to Audio. -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_dock"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</LinearLayout>
