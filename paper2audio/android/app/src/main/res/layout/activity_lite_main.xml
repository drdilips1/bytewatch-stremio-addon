<?xml version="1.0" encoding="utf-8"?>
<!-- Play Store edition: the library, with a + button to add books and text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/p2aBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="?attr/p2aText"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMenu"
            style="@style/P2A.Icon"
            android:contentDescription="Menu"
            android:src="@drawable/ic_info" />
    </LinearLayout>

    <TextView
        android:id="@+id/busy"
        style="@style/P2A.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="96dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Listen to anything"
                android:textColor="?attr/p2aText"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/P2A.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Tap + to add a book, PDF, Word file, web page, photo of a page or any text. No limits, no account." />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_play"
            android:contentDescription="Add"
            android:elevation="6dp"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add"
            android:tint="?attr/p2aOnAccent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/adBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
