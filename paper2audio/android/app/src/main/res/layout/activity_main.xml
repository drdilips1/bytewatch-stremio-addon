<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open PDF, EPUB or text file" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="arXiv ID or link"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnFetch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get" />
        </LinearLayout>

        <TextView
            android:id="@+id/docTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No document open"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/docInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <TextView
            android:id="@+id/currentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1A808080"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="8"
            android:minLines="3"
            android:padding="12dp"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/posBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/posLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:gravity="center"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏮" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="▶ Play" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏭" />
        </LinearLayout>

        <Button
            android:id="@+id/btnChapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chapters" />

        <TextView
            android:id="@+id/speedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Speed" />

        <SeekBar
            android:id="@+id/speedBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="25" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Voice" />

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnMoreVoices"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get more phone voices" />

        <Button
            android:id="@+id/btnKokoro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Download Kokoro voices"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/kokoroProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/kokoroStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="What to read"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbRefs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Skip references and notes" />

        <CheckBox
            android:id="@+id/cbCites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Remove inline citations" />

        <CheckBox
            android:id="@+id/cbCaptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Skip figure and table captions" />

        <CheckBox
            android:id="@+id/cbAppendix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skip appendix" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save as audio file" />

        <ProgressBar
            android:id="@+id/exportProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/exportStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7" />

        <Button
            android:id="@+id/btnOpenAudio"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open saved audio"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
