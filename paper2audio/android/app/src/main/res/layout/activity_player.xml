<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/p2aBackground"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/P2A.Icon"
            android:contentDescription="Back to library"
            android:src="@drawable/ic_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnNotes"
            style="@style/P2A.Icon"
            android:contentDescription="Bookmarks and notes"
            android:src="@drawable/ic_bookmark" />

        <ImageButton
            android:id="@+id/btnChapters"
            style="@style/P2A.Icon"
            android:contentDescription="Table of contents"
            android:src="@drawable/ic_list" />

        <ImageButton
            android:id="@+id/btnDetails"
            style="@style/P2A.Icon"
            android:contentDescription="Book details and cover"
            android:src="@drawable/ic_info" />

        <ImageButton
            android:id="@+id/btnVoiceStudio"
            style="@style/P2A.Icon"
            android:contentDescription="Voice studio"
            android:src="@drawable/ic_voice" />

        <ImageButton
            android:id="@+id/btnTheme"
            style="@style/P2A.Icon"
            android:contentDescription="Theme"
            android:src="@drawable/ic_palette" />
    </LinearLayout>

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="66dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_thumb"
            android:elevation="4dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/docTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/p2aText"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/docAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/p2aMuted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/docInfo"
                style="@style/P2A.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/tabReader"
            style="@style/P2A.Button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="Reader" />

        <Button
            android:id="@+id/tabOptions"
            style="@style/P2A.Button.Soft"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_tune"
            android:minHeight="40dp"
            android:text="Voice &amp; options" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/reader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="16dp"
            android:scrollbarStyle="outsideOverlay" />

        <ScrollView
            android:id="@+id/optionsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/docDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="4"
                    android:padding="14dp"
                    android:textColor="?attr/p2aMuted"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Voice and speed -->
                <LinearLayout
                    style="@style/P2A.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/P2A.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voice and speed" />

                    <Spinner
                        android:id="@+id/voiceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="?attr/p2aMuted" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPreview"
                            style="@style/P2A.Button.Soft"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:drawableStart="@drawable/ic_play"
                            android:minHeight="40dp"
                            android:text="Preview" />

                        <Button
                            android:id="@+id/btnStudio"
                            style="@style/P2A.Button.Soft"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:drawableStart="@drawable/ic_voice"
                            android:minHeight="40dp"
                            android:text="Voice studio" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/langHint"
                        style="@style/P2A.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/speedLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="?attr/p2aText" />

                    <SeekBar
                        android:id="@+id/speedBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="35"
                        android:progressBackgroundTint="?attr/p2aSurface2"
                        android:progressTint="?attr/p2aAccent"
                        android:thumbTint="?attr/p2aAccent" />

                    <Button
                        android:id="@+id/btnKokoro"
                        style="@style/P2A.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Download Kokoro voices"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/kokoroProgress"
                        style="@style/P2A.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/kokoroStatus"
                        style="@style/P2A.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMoreVoices"
                            style="@style/P2A.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Get more phone voices" />

                        <Button
                            android:id="@+id/btnDeleteKokoro"
                            style="@style/P2A.Button.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delete Kokoro (~350 MB)"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- AI -->
                <LinearLayout
                    style="@style/P2A.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/P2A.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI (free, with Google Gemini)" />

                    <TextView
                        android:id="@+id/aiStatus"
                        style="@style/P2A.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnShortSummary"
                            style="@style/P2A.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:text="Short summary" />

                        <Button
                            android:id="@+id/btnLongSummary"
                            style="@style/P2A.Button.Soft"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:text="Long summary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnChapterSummary"
                        style="@style/P2A.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Summarize this chapter" />

                    <Button
                        android:id="@+id/btnVisuals"
                        style="@style/P2A.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Explain figures and tables" />

                    <Button
                        android:id="@+id/btnTranslate"
                        style="@style/P2A.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Translate and listen…" />

                    <CheckBox
                        android:id="@+id/cbVisuals"
                        style="@style/P2A.Check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Read figure and table explanations where they're mentioned" />

                    <ProgressBar
                        android:id="@+id/aiProgress"
                        style="@style/P2A.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnGeminiKey"
                        style="@style/P2A.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini key" />
                </LinearLayout>

                <!-- Offline -->
                <LinearLayout
                    style="@style/P2A.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/P2A.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Listen offline" />

                    <TextView
                        android:id="@+id/offlineStatus"
                        style="@style/P2A.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/btnOffline"
                        style="@style/P2A.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/ic_save"
                        android:text="Download for offline listening" />

                    <ProgressBar
                        android:id="@+id/offlineProgress"
                        style="@style/P2A.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnClearCache"
                        style="@style/P2A.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear downloaded audio" />
                </LinearLayout>

                <!-- Save audio -->
                <LinearLayout
                    style="@style/P2A.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/P2A.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save as audio file" />

                    <TextView
                        style="@style/P2A.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="One audio file of the whole document in Music/Paper2Audio, for any music or podcast app." />

                    <Button
                        android:id="@+id/btnExport"
                        style="@style/P2A.Button.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:drawableStart="@drawable/ic_save"
                        android:text="Save audio file" />

                    <ProgressBar
                        android:id="@+id/exportProgress"
                        style="@style/P2A.Progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/exportStatus"
                        style="@style/P2A.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/btnOpenAudio"
                        style="@style/P2A.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open saved audio"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Reading options -->
                <LinearLayout
                    style="@style/P2A.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/P2A.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What to read" />

                    <CheckBox
                        android:id="@+id/cbRefs"
                        style="@style/P2A.Check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skip references and notes" />

                    <CheckBox
                        android:id="@+id/cbCites"
                        style="@style/P2A.Check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remove inline citations" />

                    <CheckBox
                        android:id="@+id/cbCaptions"
                        style="@style/P2A.Check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skip figure and table captions" />

                    <CheckBox
                        android:id="@+id/cbAppendix"
                        style="@style/P2A.Check"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Skip appendix" />

                    <TextView
                        android:id="@+id/textSizeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="?attr/p2aText" />

                    <SeekBar
                        android:id="@+id/textSizeBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="14"
                        android:progressBackgroundTint="?attr/p2aSurface2"
                        android:progressTint="?attr/p2aAccent"
                        android:thumbTint="?attr/p2aAccent" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Player bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bar"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <SeekBar
            android:id="@+id/posBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressBackgroundTint="?attr/p2aSurface2"
            android:progressTint="?attr/p2aAccent"
            android:thumbTint="?attr/p2aAccent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/posLabel"
                style="@style/P2A.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeLabel"
                style="@style/P2A.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSleep"
                style="@style/P2A.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_timer"
                android:drawableTint="?attr/p2aText"
                android:minWidth="0dp"
                android:text="Sleep"
                android:textColor="?attr/p2aMuted"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/P2A.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Previous paragraph"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_play"
                android:contentDescription="Play or pause"
                android:elevation="6dp"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="?attr/p2aOnAccent" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/P2A.Icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Next paragraph"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next" />

            <Button
                android:id="@+id/btnSpeed"
                style="@style/P2A.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="1.0×"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
