<?xml version="1.0" encoding="utf-8"?>
<!-- Narrato's own look: Pearl by day, Midnight by night (sapphire and platinum); Ivory stays as before. -->
<resources>
    <style name="Theme.P2A.Ivory" parent="android:Theme.Material.Light.NoActionBar">
        <item name="p2aBg">#F6F3ED</item>
        <item name="p2aSurface">#FFFDF9</item>
        <item name="p2aSurface2">#ECE6DA</item>
        <item name="p2aAccent">#3E776A</item>
        <item name="p2aPlay">#3E776A</item>
        <item name="p2aOnAccent">#FFFFFF</item>
        <item name="p2aText">#202A3B</item>
        <item name="p2aMuted">#6B6A66</item>
        <item name="p2aBackground">@drawable/bg_theme_ivory</item>
        <item name="android:colorPrimary">#3E776A</item>
        <item name="android:colorPrimaryDark">#F6F3ED</item>
        <item name="android:colorAccent">#3E776A</item>
        <item name="android:colorControlActivated">#3E776A</item>
        <item name="android:colorControlNormal">#6B6A66</item>
        <item name="android:windowBackground">@drawable/bg_theme_ivory</item>
        <item name="android:statusBarColor">#F6F3ED</item>
        <item name="android:navigationBarColor">#F6F3ED</item>
        <item name="android:textColorPrimary">#202A3B</item>
        <item name="android:textColorSecondary">#6B6A66</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Light.Dialog.Alert</item>
    </style>

    <!-- Pearl (the Paper theme): pearl white, white cards, ink text and sapphire blue. -->
    <style name="Theme.P2A.Paper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="p2aBg">#F4F6FA</item>
        <item name="p2aSurface">#FFFFFF</item>
        <item name="p2aSurface2">#E3E8F0</item>
        <item name="p2aAccent">#3F5FD6</item>
        <item name="p2aPlay">#3F5FD6</item>
        <item name="p2aOnAccent">#FFFFFF</item>
        <item name="p2aText">#161A22</item>
        <item name="p2aMuted">#5E6573</item>
        <item name="p2aBackground">@drawable/bg_theme_paper</item>
        <item name="android:colorPrimary">#3F5FD6</item>
        <item name="android:colorPrimaryDark">#F4F6FA</item>
        <item name="android:colorAccent">#3F5FD6</item>
        <item name="android:colorControlActivated">#3F5FD6</item>
        <item name="android:colorControlNormal">#5E6573</item>
        <item name="android:windowBackground">@drawable/bg_theme_paper</item>
        <item name="android:statusBarColor">#F4F6FA</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#161A22</item>
        <item name="android:textColorSecondary">#5E6573</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Light.Dialog.Alert</item>
    </style>


    <!-- Midnight (the Ink theme): deep ink, sapphire blue highlights and platinum buttons. -->
    <style name="Theme.P2A.Ink" parent="android:Theme.Material.NoActionBar">
        <item name="p2aBg">#0E1116</item>
        <item name="p2aSurface">#171B22</item>
        <item name="p2aSurface2">#262C38</item>
        <item name="p2aAccent">#7C9BFF</item>
        <item name="p2aPlay">#D5DCE6</item>
        <item name="p2aOnAccent">#10141C</item>
        <item name="p2aText">#F3EEE4</item>
        <item name="p2aMuted">#A3AAB8</item>
        <item name="p2aBackground">@drawable/bg_theme_ink</item>
        <item name="android:colorPrimary">#7C9BFF</item>
        <item name="android:colorPrimaryDark">#0E1116</item>
        <item name="android:colorAccent">#7C9BFF</item>
        <item name="android:colorControlActivated">#7C9BFF</item>
        <item name="android:colorControlNormal">#A3AAB8</item>
        <item name="android:windowBackground">@drawable/bg_theme_ink</item>
        <item name="android:statusBarColor">#0E1116</item>
        <item name="android:navigationBarColor">#0E1116</item>
        <item name="android:textColorPrimary">#F3EEE4</item>
        <item name="android:textColorSecondary">#A3AAB8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog.Alert</item>
    </style>
</resources>
