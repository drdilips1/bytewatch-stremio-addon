<?xml version="1.0" encoding="utf-8"?>
<!-- Narrato's main buttons: the button colour with a soft sheen (light at the top, a touch darker below). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/p2aPlay" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#59FFFFFF"
                        android:centerColor="#00FFFFFF"
                        android:endColor="#26000000" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
